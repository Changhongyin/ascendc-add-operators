// ---------------------------------------------------------------------------
// Host Dispatch: Shape Coalescing & Optimal Path Selection
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x1,
    const TensorGroupInfo& info_x1,
    GM_ADDR x2,
    const TensorGroupInfo& info_x2,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (info_x1.numTensors <= 0 || info_x2.numTensors <= 0 || info_y.numTensors <= 0) {
        return;
    }
    const TensorInfo& t1 = info_x1.tensors[0];
    const TensorInfo& t2 = info_x2.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const int32_t dtype = ty.dtype;

    uint64_t total = 1;
    for (int64_t i = 0; i < ty.numDims; ++i) {
        if (ty.shape[i] <= 0 || static_cast<uint64_t>(ty.shape[i]) > AddOp::kMaxElements / total) {
            return;
        }
        total *= static_cast<uint64_t>(ty.shape[i]);
    }
    if (total == 0) {
        return;
    }

    uint64_t x1Total = 1;
    for (int64_t i = 0; i < t1.numDims; ++i) {
        x1Total *= static_cast<uint64_t>(t1.shape[i]);
    }
    uint64_t x2Total = 1;
    for (int64_t i = 0; i < t2.numDims; ++i) {
        x2Total *= static_cast<uint64_t>(t2.shape[i]);
    }

    const int64_t rank = std::max(ty.numDims, std::max(t1.numDims, t2.numDims));
    uint64_t cOut[AddOp::kMaxDims];
    uint64_t cS1[AddOp::kMaxDims];
    uint64_t cS2[AddOp::kMaxDims];
    int32_t cDims = 0;

    for (int64_t i = 0; i < rank; ++i) {
        const int64_t idxY = i - (rank - ty.numDims);
        const int64_t idx1 = i - (rank - t1.numDims);
        const int64_t idx2 = i - (rank - t2.numDims);
        const uint64_t dy = idxY >= 0 ? static_cast<uint64_t>(ty.shape[idxY]) : 1ULL;
        const uint64_t d1 = idx1 >= 0 ? static_cast<uint64_t>(t1.shape[idx1]) : 1ULL;
        const uint64_t d2 = idx2 >= 0 ? static_cast<uint64_t>(t2.shape[idx2]) : 1ULL;
        if (dy == 1) {
            continue;
        }
        const bool b1 = (d1 == 1);
        const bool b2 = (d2 == 1);
        if (cDims > 0) {
            const bool prevB1 = (cS1[cDims - 1] == 1);
            const bool prevB2 = (cS2[cDims - 1] == 1);
            if (b1 == prevB1 && b2 == prevB2) {
                cOut[cDims - 1] *= dy;
                cS1[cDims - 1] *= d1;
                cS2[cDims - 1] *= d2;
                continue;
            }
        }
        cOut[cDims] = dy;
        cS1[cDims] = d1;
        cS2[cDims] = d2;
        ++cDims;
    }

    const uint64_t maxCores = availableCoreNum > 0 ? static_cast<uint64_t>(availableCoreNum) : 1ULL;
    const uint64_t minElemsPerBlock =
        (dtype == AddOp::kDtypeFloat16 || dtype == AddOp::kDtypeBfloat16) ? 2048ULL : 1024ULL;
    uint32_t blockNum = static_cast<uint32_t>(
        std::min<uint64_t>(maxCores, std::max<uint64_t>(1ULL, (total + minElemsPerBlock - 1) / minElemsPerBlock)));

    // Path 1: Same-shape contiguous (includes 0-D / 1-element tensors)
    if (cDims == 0 || (cDims == 1 && cS1[0] == cOut[0] && cS2[0] == cOut[0])) {
        if (dtype == AddOp::kDtypeFloat32) {
            add_same_fp32<<<blockNum, nullptr, stream>>>(x1, x2, y, total);
        } else if (dtype == AddOp::kDtypeFloat16) {
            add_same_fp16<<<blockNum, nullptr, stream>>>(x1, x2, y, total);
        } else if (dtype == AddOp::kDtypeInt32) {
            add_same_i32<<<blockNum, nullptr, stream>>>(x1, x2, y, total);
        } else if (dtype == AddOp::kDtypeBfloat16) {
            add_same_bf16<<<blockNum, nullptr, stream>>>(x1, x2, y, total);
        }
        return;
    }

    // Path 2: Scalar broadcast (one input has 1 element)
    if (cDims == 1) {
        GM_ADDR vecPtr = (cS1[0] == 1) ? x2 : x1;
        GM_ADDR sclPtr = (cS1[0] == 1) ? x1 : x2;
        if (dtype == AddOp::kDtypeFloat32) {
            add_scalar_fp32<<<blockNum, nullptr, stream>>>(vecPtr, sclPtr, y, total);
        } else if (dtype == AddOp::kDtypeFloat16) {
            add_scalar_fp16<<<blockNum, nullptr, stream>>>(vecPtr, sclPtr, y, total);
        } else if (dtype == AddOp::kDtypeInt32) {
            add_scalar_i32<<<blockNum, nullptr, stream>>>(vecPtr, sclPtr, y, total);
        } else if (dtype == AddOp::kDtypeBfloat16) {
            add_scalar_bf16<<<blockNum, nullptr, stream>>>(vecPtr, sclPtr, y, total);
        }
        return;
    }

    // Path 2b: UB-cached 2D row/bias broadcast: (M, K) + (1, K) with K <= kTile and 32B-aligned
    if (cDims == 2 && cS1[1] == cOut[1] && cS2[1] == cOut[1] && (cS1[0] == 1 || cS2[0] == 1)) {
        const bool is2B = (dtype == AddOp::kDtypeFloat16 || dtype == AddOp::kDtypeBfloat16);
        const uint64_t kAlign = is2B ? (AddOp::kDmaAlignBytes / 2ULL) : (AddOp::kDmaAlignBytes / 4ULL);
        const uint64_t kTile = is2B ? AddOp::kTileElems2B : AddOp::kTileElems4B;
        const uint64_t K = cOut[1];
        if (K <= kTile && (K % kAlign) == 0) {
            GM_ADDR matPtr = (cS1[0] == 1) ? x2 : x1;
            GM_ADDR rowPtr = (cS1[0] == 1) ? x1 : x2;
            const uint32_t k32 = static_cast<uint32_t>(K);
            if (dtype == AddOp::kDtypeFloat32) {
                add_row_fp32<<<blockNum, nullptr, stream>>>(matPtr, rowPtr, y, total, k32);
            } else if (dtype == AddOp::kDtypeFloat16) {
                add_row_fp16<<<blockNum, nullptr, stream>>>(matPtr, rowPtr, y, total, k32);
            } else if (dtype == AddOp::kDtypeInt32) {
                add_row_i32<<<blockNum, nullptr, stream>>>(matPtr, rowPtr, y, total, k32);
            } else if (dtype == AddOp::kDtypeBfloat16) {
                add_row_bf16<<<blockNum, nullptr, stream>>>(matPtr, rowPtr, y, total, k32);
            }
            return;
        }
    }

    // Path 3: General ND Broadcast (cDims >= 2)
    uint64_t str1[AddOp::kMaxDims];
    uint64_t str2[AddOp::kMaxDims];
    uint64_t acc1 = 1;
    uint64_t acc2 = 1;
    for (int32_t d = cDims - 1; d >= 0; --d) {
        str1[d] = (cS1[d] == 1) ? 0ULL : acc1;
        str2[d] = (cS2[d] == 1) ? 0ULL : acc2;
        acc1 *= cS1[d];
        acc2 *= cS2[d];
    }

    AddOp::BroadcastMeta meta{};
    meta.totalElements = total;
    meta.innerLen = cOut[cDims - 1];
    meta.outerRows = total / meta.innerLen;
    meta.outerDims = cDims - 1;
    for (int32_t d = 0; d < meta.outerDims; ++d) {
        meta.outDims[d] = cOut[d];
    }

    const bool lastB1 = (cS1[cDims - 1] == 1);
    const bool lastB2 = (cS2[cDims - 1] == 1);

    if (!lastB1 && !lastB2) {
        meta.x1Elements = x1Total;
        meta.x2Elements = x2Total;
        for (int32_t d = 0; d < meta.outerDims; ++d) {
            meta.x1Strides[d] = str1[d];
            meta.x2Strides[d] = str2[d];
        }
        if (dtype == AddOp::kDtypeFloat32) {
            add_bcast_both_fp32<<<blockNum, nullptr, stream>>>(x1, x2, y, meta);
        } else if (dtype == AddOp::kDtypeFloat16) {
            add_bcast_both_fp16<<<blockNum, nullptr, stream>>>(x1, x2, y, meta);
        } else if (dtype == AddOp::kDtypeInt32) {
            add_bcast_both_i32<<<blockNum, nullptr, stream>>>(x1, x2, y, meta);
        } else if (dtype == AddOp::kDtypeBfloat16) {
            add_bcast_both_bf16<<<blockNum, nullptr, stream>>>(x1, x2, y, meta);
        }
    } else {
        GM_ADDR vecPtr = lastB1 ? x2 : x1;
        GM_ADDR bcastPtr = lastB1 ? x1 : x2;
        meta.x1Elements = lastB1 ? x2Total : x1Total;
        meta.x2Elements = lastB1 ? x1Total : x2Total;
        for (int32_t d = 0; d < meta.outerDims; ++d) {
            meta.x1Strides[d] = lastB1 ? str2[d] : str1[d];
            meta.x2Strides[d] = lastB1 ? str1[d] : str2[d];
        }
        if (dtype == AddOp::kDtypeFloat32) {
            add_bcast_inner_fp32<<<blockNum, nullptr, stream>>>(vecPtr, bcastPtr, y, meta);
        } else if (dtype == AddOp::kDtypeFloat16) {
            add_bcast_inner_fp16<<<blockNum, nullptr, stream>>>(vecPtr, bcastPtr, y, meta);
        } else if (dtype == AddOp::kDtypeInt32) {
            add_bcast_inner_i32<<<blockNum, nullptr, stream>>>(vecPtr, bcastPtr, y, meta);
        } else if (dtype == AddOp::kDtypeBfloat16) {
            add_bcast_inner_bf16<<<blockNum, nullptr, stream>>>(vecPtr, bcastPtr, y, meta);
        }
    }
}
