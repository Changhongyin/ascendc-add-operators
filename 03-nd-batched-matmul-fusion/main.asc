#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

#include "acl/acl.h"
#ifndef GM_ADDR
#define GM_ADDR __gm__ uint8_t*
#endif
#include "kernel.asc"

namespace {

bool CheckAcl(aclError status, const char* op)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed (ACL error %d)\n", op, static_cast<int>(status));
    return false;
}

struct AclSession {
    bool initialized = false;
    bool selected = false;
    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    int64_t vectorCores = 8;

    bool Start(int32_t dev)
    {
        deviceId = dev;
        initialized = CheckAcl(aclInit(nullptr), "aclInit");
        selected = initialized && CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice");
        if (!selected || !CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
            return false;
        }
        int64_t cores = 0;
        if (aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores) == ACL_SUCCESS && cores > 0) {
            vectorCores = cores;
        }
        return true;
    }

    ~AclSession()
    {
        if (stream != nullptr) {
            CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream");
        }
        if (selected) {
            CheckAcl(aclrtResetDevice(deviceId), "aclrtResetDevice");
        }
        if (initialized) {
            CheckAcl(aclFinalize(), "aclFinalize");
        }
    }
};

struct DeviceBuf {
    void* ptr = nullptr;
    bool Alloc(size_t bytes)
    {
        return CheckAcl(aclrtMalloc(&ptr, bytes ? bytes : 1, ACL_MEM_MALLOC_NORMAL_ONLY), "aclrtMalloc");
    }
    ~DeviceBuf()
    {
        if (ptr != nullptr) {
            CheckAcl(aclrtFree(ptr), "aclrtFree");
        }
    }
};

uint64_t Product(const std::vector<int64_t>& s)
{
    uint64_t p = 1;
    for (int64_t d : s) {
        p *= static_cast<uint64_t>(d);
    }
    return p;
}

float RefAct(float x, int32_t act)
{
    if (act == NdBmmOp::kActRelu) {
        return x > 0.0f ? x : 0.0f;
    }
    if (act == NdBmmOp::kActSilu) {
        const float clamped = std::min(80.0f, -x);
        return x / (1.0f + std::exp(clamped));
    }
    if (act == NdBmmOp::kActGelu) {
        const float u = 0.7978845608028654f * (x + 0.044715f * x * x * x);
        return 0.5f * x * (1.0f + std::tanh(u));
    }
    return x;
}

struct CaseSpec {
    const char* name;
    std::vector<int64_t> sA;
    std::vector<int64_t> sB;
    std::vector<int64_t> sC;
    std::vector<int64_t> sY;
    NdBmmConfig cfg;
};

bool RunFp32Case(const AclSession& session, const CaseSpec& cs, bool benchmark)
{
    const uint64_t nA = Product(cs.sA);
    const uint64_t nB = Product(cs.sB);
    const uint64_t nC = cs.sC.empty() ? 0 : Product(cs.sC);
    const uint64_t nY = Product(cs.sY);
    constexpr float kGuard = -987654.0f;
    constexpr size_t kGuardElems = 32;

    std::vector<float> hA(nA), hB(nB), hC(nC), hY(nY + kGuardElems, kGuard);
    for (uint64_t i = 0; i < nA; ++i) {
        hA[i] = (static_cast<int32_t>(i % 29) - 14) * 0.0625f;
    }
    for (uint64_t i = 0; i < nB; ++i) {
        hB[i] = (static_cast<int32_t>(i % 23) - 11) * 0.0625f;
    }
    for (uint64_t i = 0; i < nC; ++i) {
        hC[i] = (static_cast<int32_t>(i % 19) - 9) * 0.125f;
    }

    DeviceBuf dA, dB, dC, dY;
    if (!dA.Alloc(nA * sizeof(float)) || !dB.Alloc(nB * sizeof(float)) || !dY.Alloc(hY.size() * sizeof(float))) {
        return false;
    }
    if (nC > 0 && !dC.Alloc(nC * sizeof(float))) {
        return false;
    }
    if (!CheckAcl(aclrtMemcpy(dA.ptr, nA * 4, hA.data(), nA * 4, ACL_MEMCPY_HOST_TO_DEVICE), "h2d A") ||
        !CheckAcl(aclrtMemcpy(dB.ptr, nB * 4, hB.data(), nB * 4, ACL_MEMCPY_HOST_TO_DEVICE), "h2d B") ||
        !CheckAcl(aclrtMemcpy(dY.ptr, hY.size() * 4, hY.data(), hY.size() * 4, ACL_MEMCPY_HOST_TO_DEVICE), "h2d Y")) {
        return false;
    }
    if (nC > 0 && !CheckAcl(aclrtMemcpy(dC.ptr, nC * 4, hC.data(), nC * 4, ACL_MEMCPY_HOST_TO_DEVICE), "h2d C")) {
        return false;
    }

    NdBmmTensorDesc descA{cs.sA.data(), static_cast<int64_t>(cs.sA.size()), NdBmmOp::kDtypeFloat32};
    NdBmmTensorDesc descB{cs.sB.data(), static_cast<int64_t>(cs.sB.size()), NdBmmOp::kDtypeFloat32};
    NdBmmTensorDesc descC{cs.sC.empty() ? nullptr : cs.sC.data(), static_cast<int64_t>(cs.sC.size()), NdBmmOp::kDtypeFloat32};
    NdBmmTensorDesc descY{cs.sY.data(), static_cast<int64_t>(cs.sY.size()), NdBmmOp::kDtypeFloat32};

    if (benchmark) {
        aclrtEvent evStart = nullptr, evEnd = nullptr;
        CheckAcl(aclrtCreateEventWithFlag(&evStart, ACL_EVENT_TIME_LINE), "evStart");
        CheckAcl(aclrtCreateEventWithFlag(&evEnd, ACL_EVENT_TIME_LINE), "evEnd");
        for (int w = 0; w < 5; ++w) {
            run_nd_bmm_fused(static_cast<GM_ADDR>(dA.ptr), descA, static_cast<GM_ADDR>(dB.ptr), descB,
                             static_cast<GM_ADDR>(dC.ptr), nC ? &descC : nullptr,
                             static_cast<GM_ADDR>(dY.ptr), descY, cs.cfg, session.vectorCores, session.stream);
        }
        CheckAcl(aclrtSynchronizeStream(session.stream), "warmup");
        constexpr int kRuns = 20;
        CheckAcl(aclrtRecordEvent(evStart, session.stream), "recStart");
        for (int r = 0; r < kRuns; ++r) {
            run_nd_bmm_fused(static_cast<GM_ADDR>(dA.ptr), descA, static_cast<GM_ADDR>(dB.ptr), descB,
                             static_cast<GM_ADDR>(dC.ptr), nC ? &descC : nullptr,
                             static_cast<GM_ADDR>(dY.ptr), descY, cs.cfg, session.vectorCores, session.stream);
        }
        CheckAcl(aclrtRecordEvent(evEnd, session.stream), "recEnd");
        CheckAcl(aclrtSynchronizeStream(session.stream), "syncBench");
        float ms = 0.0f;
        CheckAcl(aclrtEventElapsedTime(&ms, evStart, evEnd), "elapsed");
        aclrtDestroyEvent(evStart);
        aclrtDestroyEvent(evEnd);

        const double avgUs = (static_cast<double>(ms) * 1000.0) / kRuns;
        const uint64_t M = static_cast<uint64_t>(cs.sA[cs.sA.size() - 2]);
        const uint64_t K = static_cast<uint64_t>(cs.sA[cs.sA.size() - 1]);
        const uint64_t N = static_cast<uint64_t>(cs.sY[cs.sY.size() - 1]);
        const uint64_t batches = nY / (M * N);
        const double flops = 2.0 * static_cast<double>(batches) * M * N * K;
        const double gflops = avgUs > 0.0 ? (flops / (avgUs * 1e3)) : 0.0;
        std::printf("BENCH %s avg_us=%.3f gflops=%.2f\n", cs.name, avgUs, gflops);
    } else {
        if (!run_nd_bmm_fused(static_cast<GM_ADDR>(dA.ptr), descA, static_cast<GM_ADDR>(dB.ptr), descB,
                              static_cast<GM_ADDR>(dC.ptr), nC ? &descC : nullptr,
                              static_cast<GM_ADDR>(dY.ptr), descY, cs.cfg, session.vectorCores, session.stream)) {
            std::fprintf(stderr, "Dispatch rejected on %s\n", cs.name);
            return false;
        }
        if (!CheckAcl(aclrtSynchronizeStream(session.stream), "sync")) {
            return false;
        }
    }

    if (!CheckAcl(aclrtMemcpy(hY.data(), hY.size() * 4, dY.ptr, hY.size() * 4, ACL_MEMCPY_DEVICE_TO_HOST), "d2h Y")) {
        return false;
    }

    // Verify guard bytes
    for (size_t i = nY; i < hY.size(); ++i) {
        if (hY[i] != kGuard) {
            std::fprintf(stderr, "FAIL %s guard overwritten at %zu\n", cs.name, i);
            return false;
        }
    }

    // CPU reference check for validation cases
    if (!benchmark) {
        const uint64_t M = static_cast<uint64_t>(cs.sA[cs.sA.size() - 2]);
        const uint64_t K = static_cast<uint64_t>(cs.sA[cs.sA.size() - 1]);
        const uint64_t N = static_cast<uint64_t>(cs.sY[cs.sY.size() - 1]);
        const size_t yBatchRank = cs.sY.size() - 2;
        const uint64_t batches = nY / (M * N);

        auto batchStride = [&](const std::vector<int64_t>& sh, uint64_t matElems) {
            std::vector<uint64_t> st(yBatchRank, 0);
            if (sh.empty()) return st;
            const size_t br = (sh.size() >= 2) ? (sh.size() - 2) : 0;
            uint64_t acc = matElems;
            for (size_t k = 0; k < br; ++k) {
                const size_t idx = br - 1 - k;
                const size_t oidx = yBatchRank - 1 - k;
                if (sh[idx] > 1) {
                    st[oidx] = acc;
                    acc *= static_cast<uint64_t>(sh[idx]);
                }
            }
            return st;
        };

        const bool rowBias = !cs.sC.empty() && (cs.sC.size() == 1 || cs.sC[cs.sC.size() - 2] == 1);
        const auto stA = batchStride(cs.sA, M * K);
        const auto stB = batchStride(cs.sB, K * N);
        const auto stC = batchStride(cs.sC, rowBias ? N : M * N);

        for (uint64_t b = 0; b < batches; ++b) {
            uint64_t rem = b, aOff = 0, bOff = 0, cOff = 0;
            for (size_t k = 0; k < yBatchRank; ++k) {
                const size_t d = yBatchRank - 1 - k;
                const uint64_t dim = static_cast<uint64_t>(cs.sY[d]);
                const uint64_t c = rem % dim;
                rem /= dim;
                aOff += c * stA[d];
                bOff += c * stB[d];
                cOff += c * stC[d];
            }
            for (uint64_t m = 0; m < M; ++m) {
                for (uint64_t n = 0; n < N; ++n) {
                    float acc = 0.0f;
                    for (uint64_t k = 0; k < K; ++k) {
                        const float av = hA[aOff + m * K + k];
                        const float bv = cs.cfg.transB ? hB[bOff + n * K + k] : hB[bOff + k * N + n];
                        acc += av * bv;
                    }
                    float val = cs.cfg.alpha * acc;
                    if (!cs.sC.empty()) {
                        val += cs.cfg.beta * hC[cOff + (rowBias ? n : m * N + n)];
                    }
                    val = RefAct(val, cs.cfg.actMode);
                    const float got = hY[b * M * N + m * N + n];
                    if (std::fabs(got - val) > 1e-3f + 1e-3f * std::fabs(val)) {
                        std::fprintf(stderr, "FAIL %s b=%llu m=%llu n=%llu exp=%g got=%g\n",
                                     cs.name, static_cast<unsigned long long>(b),
                                     static_cast<unsigned long long>(m), static_cast<unsigned long long>(n), val, got);
                        return false;
                    }
                }
            }
        }
        std::printf("PASS %s (N_out=%llu)\n", cs.name, static_cast<unsigned long long>(nY));
    }
    return true;
}

} // namespace

int main(int argc, char** argv)
{
    const bool benchmark = (argc > 1 && std::strcmp(argv[1], "--benchmark") == 0);
    const char* envDev = std::getenv("DEVICE_ID");
    const int32_t devId = (envDev != nullptr && envDev[0] != '\0') ? std::atoi(envDev) : 0;

    AclSession session;
    if (!session.Start(devId)) {
        return 1;
    }

    const std::vector<CaseSpec> cases = {
        {"gemm_2d_silu", {33, 65}, {65, 70}, {70}, {33, 70}, {false, NdBmmOp::kActSilu, 1.0f, 1.0f}},
        {"mha_4d_qkt_mask", {2, 4, 32, 64}, {2, 4, 32, 64}, {2, 1, 32, 32}, {2, 4, 32, 32},
         {true, NdBmmOp::kActNone, 0.125f, 1.0f}},
        {"gqa_5d_bcast_gelu", {2, 2, 4, 17, 33}, {2, 2, 1, 33, 65}, {1, 2, 1, 1, 65}, {2, 2, 4, 17, 65},
         {false, NdBmmOp::kActGelu, 1.0f, 1.0f}},
        {"tensor_6d_bcast_relu", {2, 1, 3, 2, 19, 31}, {1, 2, 1, 2, 29, 31}, {2, 2, 3, 1, 19, 29},
         {2, 2, 3, 2, 19, 29}, {true, NdBmmOp::kActRelu, 0.5f, 0.25f}},
        {"tensor_8d_bcast", {2, 1, 2, 1, 2, 1, 9, 17}, {1, 2, 1, 2, 1, 2, 17, 13}, {13},
         {2, 2, 2, 2, 2, 2, 9, 13}, {false, NdBmmOp::kActSilu, 1.0f, 1.0f}},
    };

    for (const auto& cs : cases) {
        if (!RunFp32Case(session, cs, benchmark)) {
            return 1;
        }
    }
    return 0;
}
