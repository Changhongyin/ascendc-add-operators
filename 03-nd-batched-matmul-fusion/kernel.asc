#include <algorithm>
#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

namespace NdBmmOp {

constexpr int32_t kDtypeFloat32 = 0;
constexpr int32_t kDtypeFloat16 = 1;
constexpr int32_t kDtypeBfloat16 = 2;

constexpr int32_t kActNone = 0;
constexpr int32_t kActRelu = 1;
constexpr int32_t kActSilu = 2;
constexpr int32_t kActGelu = 3;

constexpr int32_t kBiasNone = 0;
constexpr int32_t kBiasRow = 1;     // Broadcast across M: [..., 1, N]
constexpr int32_t kBiasMatrix = 2;  // Full matrix / residual: [..., M, N]

// Up to 8D tensors: up to 6 batch dimensions + 2 matrix dimensions (M, K) x (K, N).
constexpr int32_t kMaxBatchDims = 6;
constexpr int32_t kMaxTensorDims = kMaxBatchDims + 2;
constexpr uint32_t kDmaAlignBytes = 32;
constexpr uint32_t kVectorRepeatBytes = 256;

// Blocked outer-product tiling:
// kTileN = 64 FP32 = 256 B (1 exact Vector Repeat) -> zero tail mask overhead in inner FMA & epilogue!
// UB footprint (well below 192 KB Atlas A2/A3 limit):
// - FP32: qA(4KB) + qB(16KB) + qC(4KB) + qY(4KB) + acc(4KB) + tmp(4KB) + bTrans(16KB if transB) <= 52 KB
// - 2B:   qA(2KB) + qB(8KB) + qC(2KB) + qY(2KB) + aF32(4KB) + bF32(16KB) + acc(4KB) + tmp(4KB) = 42 KB
constexpr uint32_t kTileM = 16;
constexpr uint32_t kTileN = 64;
constexpr uint32_t kTileK = 64;
constexpr uint32_t kTileAccElems = kTileM * kTileN; // 1024 (16 exact FP32 vector repeats)

struct NdBmmMeta {
    uint64_t totalBatches;
    uint32_t M;
    uint32_t N;
    uint32_t K;
    uint32_t tilesM;
    uint32_t tilesN;
    uint64_t totalTiles;
    uint64_t aTotalElems;
    uint64_t bTotalElems;
    uint64_t cTotalElems;
    uint64_t yTotalElems;
    int32_t batchDims;
    int32_t transB;
    int32_t biasMode;
    int32_t actMode;
    float alpha;
    float beta;
    uint32_t batchShape[kMaxBatchDims];
    uint64_t aBatchStrides[kMaxBatchDims];
    uint64_t bBatchStrides[kMaxBatchDims];
    uint64_t cBatchStrides[kMaxBatchDims];
};

template <typename T>
__aicore__ inline void CopyInRow(const AscendC::LocalTensor<T>& dst,
                                 const AscendC::GlobalTensor<T>& src,
                                 uint64_t gmOffset,
                                 uint32_t count)
{
    constexpr uint32_t kAlign = kDmaAlignBytes / sizeof(T);
    const bool aligned = ((gmOffset % kAlign) == 0) && ((count % kAlign) == 0);
    if (aligned) {
        AscendC::DataCopy(dst, src[gmOffset], count);
    } else {
        const AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        const AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, T{}};
        AscendC::DataCopyPad(dst, src[gmOffset], copy, pad);
    }
}

template <typename T>
__aicore__ inline void CopyOutRow(const AscendC::GlobalTensor<T>& dst,
                                  uint64_t gmOffset,
                                  const AscendC::LocalTensor<T>& src,
                                  uint32_t count)
{
    constexpr uint32_t kAlign = kDmaAlignBytes / sizeof(T);
    const bool aligned = ((gmOffset % kAlign) == 0) && ((count % kAlign) == 0);
    if (aligned) {
        AscendC::DataCopy(dst[gmOffset], src, count);
    } else {
        const AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(dst[gmOffset], src, copy);
    }
}

template <typename DstT, typename SrcT>
__aicore__ inline void SafeCast(const AscendC::LocalTensor<DstT>& dst,
                                const AscendC::LocalTensor<SrcT>& src,
                                AscendC::RoundMode mode,
                                uint32_t count)
{
    constexpr uint32_t kChunk = 64;
    const uint32_t whole = count - (count % kChunk);
    if (whole != 0) {
        AscendC::Cast(dst, src, mode, whole);
    }
    const uint32_t rem = count - whole;
    if (rem != 0) {
        AscendC::Cast(dst[whole], src[whole], mode, rem);
    }
}

__aicore__ inline void SyncVToS(AscendC::TPipe& pipe)
{
    const auto ev = pipe.FetchEventID(AscendC::HardEvent::V_S);
    AscendC::SetFlag<AscendC::HardEvent::V_S>(ev);
    AscendC::WaitFlag<AscendC::HardEvent::V_S>(ev);
    pipe.ReleaseEventID<AscendC::HardEvent::V_S>(ev);
}

__aicore__ inline void SyncSToV(AscendC::TPipe& pipe)
{
    const auto ev = pipe.FetchEventID(AscendC::HardEvent::S_V);
    AscendC::SetFlag<AscendC::HardEvent::S_V>(ev);
    AscendC::WaitFlag<AscendC::HardEvent::S_V>(ev);
    pipe.ReleaseEventID<AscendC::HardEvent::S_V>(ev);
}

__aicore__ inline void ComputeBatchOffsets(uint64_t batchIdx,
                                           const NdBmmMeta& meta,
                                           uint64_t& aBase,
                                           uint64_t& bBase,
                                           uint64_t& cBase)
{
    uint64_t rem = batchIdx;
    uint64_t oa = 0;
    uint64_t ob = 0;
    uint64_t oc = 0;
    for (int32_t d = meta.batchDims - 1; d >= 0; --d) {
        const uint64_t dim = meta.batchShape[d];
        const uint64_t coord = rem % dim;
        rem /= dim;
        oa += coord * meta.aBatchStrides[d];
        ob += coord * meta.bBatchStrides[d];
        oc += coord * meta.cBatchStrides[d];
    }
    aBase = oa;
    bBase = ob;
    cBase = oc;
}

template <typename T, bool is2BFloat>
class BatchedGemmFusedKernel {
public:
    __aicore__ inline void Run(__gm__ T* aPtr, __gm__ T* bPtr, __gm__ T* cPtr, __gm__ T* yPtr,
                               const NdBmmMeta& meta)
    {
        const uint64_t block = AscendC::GetBlockIdx();
        const uint64_t blocks = AscendC::GetBlockNum();
        const uint64_t tilesPerBlock = meta.totalTiles / blocks;
        const uint64_t extra = meta.totalTiles % blocks;
        const uint64_t pre = block < extra ? block : extra;
        const uint64_t tileStart = block * tilesPerBlock + pre;
        const uint64_t tileStop = tileStart + tilesPerBlock + (block < extra ? 1 : 0);
        if (tileStart >= tileStop) {
            return;
        }

        aGm_.SetGlobalBuffer(aPtr, meta.aTotalElems);
        bGm_.SetGlobalBuffer(bPtr, meta.bTotalElems);
        if (meta.biasMode != kBiasNone && cPtr != nullptr) {
            cGm_.SetGlobalBuffer(cPtr, meta.cTotalElems);
        }
        yGm_.SetGlobalBuffer(yPtr, meta.yTotalElems);

        AscendC::TPipe pipe;
        pipe.InitBuffer(qA_, 1, kTileM * kTileK * sizeof(T));
        pipe.InitBuffer(qB_, 1, kTileK * kTileN * sizeof(T));
        pipe.InitBuffer(qY_, 1, kTileAccElems * sizeof(T));
        if (meta.biasMode != kBiasNone) {
            pipe.InitBuffer(qC_, 1, kTileAccElems * sizeof(T));
        }
        pipe.InitBuffer(accBuf_, kTileAccElems * sizeof(float));
        pipe.InitBuffer(tmpBuf_, kTileAccElems * sizeof(float));
        if constexpr (is2BFloat) {
            pipe.InitBuffer(aF32Buf_, kTileM * kTileK * sizeof(float));
            pipe.InitBuffer(bF32Buf_, kTileK * kTileN * sizeof(float));
        }
        if (meta.transB != 0) {
            pipe.InitBuffer(bTransBuf_, kTileK * kTileN * sizeof(float));
        }

        const uint64_t tilesPerBatch = static_cast<uint64_t>(meta.tilesM) * meta.tilesN;
        uint64_t cachedBatch = ~static_cast<uint64_t>(0);
        uint64_t aBase = 0;
        uint64_t bBase = 0;
        uint64_t cBase = 0;

        for (uint64_t tileId = tileStart; tileId < tileStop; ++tileId) {
            const uint64_t batchIdx = tileId / tilesPerBatch;
            const uint64_t inBatch = tileId % tilesPerBatch;
            const uint32_t tm = static_cast<uint32_t>(inBatch / meta.tilesN);
            const uint32_t tn = static_cast<uint32_t>(inBatch % meta.tilesN);

            if (batchIdx != cachedBatch) {
                ComputeBatchOffsets(batchIdx, meta, aBase, bBase, cBase);
                cachedBatch = batchIdx;
            }
            const uint64_t yBase = batchIdx * static_cast<uint64_t>(meta.M) * meta.N;
            ProcessOutputTile(pipe, aBase, bBase, cBase, yBase, tm * kTileM, tn * kTileN, meta);
        }
    }

private:
    __aicore__ inline void ProcessOutputTile(AscendC::TPipe& pipe,
                                             uint64_t aBase,
                                             uint64_t bBase,
                                             uint64_t cBase,
                                             uint64_t yBase,
                                             uint32_t m0,
                                             uint32_t n0,
                                             const NdBmmMeta& meta)
    {
        const uint32_t curM = (m0 + kTileM <= meta.M) ? kTileM : (meta.M - m0);
        const uint32_t curN = (n0 + kTileN <= meta.N) ? kTileN : (meta.N - n0);
        const uint32_t accCount = curM * kTileN; // exact multiple of 64 (256B)

        auto acc = accBuf_.Get<float>();
        AscendC::Duplicate(acc, 0.0f, accCount);
        AscendC::PipeBarrier<PIPE_V>();

        for (uint32_t k0 = 0; k0 < meta.K; k0 += kTileK) {
            const uint32_t curK = (k0 + kTileK <= meta.K) ? kTileK : (meta.K - k0);

            // 1. Copy A tile [curM, curK] (row stride kTileK)
            auto aIn = qA_.AllocTensor<T>();
            if constexpr (!is2BFloat) {
                if (curK < kTileK) {
                    AscendC::Duplicate(aIn, 0.0f, curM * kTileK);
                    AscendC::PipeBarrier<PIPE_V>();
                }
            }
            for (uint32_t m = 0; m < curM; ++m) {
                const uint64_t aOff = aBase + static_cast<uint64_t>(m0 + m) * meta.K + k0;
                CopyInRow(aIn[m * kTileK], aGm_, aOff, curK);
            }
            qA_.EnQue(aIn);

            // 2. Copy B tile: [curK, curN] (stride kTileN) or transposed [curN, curK] (stride kTileK)
            auto bIn = qB_.AllocTensor<T>();
            const uint32_t bRows = (meta.transB == 0) ? curK : curN;
            const uint32_t bCols = (meta.transB == 0) ? curN : curK;
            const uint32_t bStride = (meta.transB == 0) ? kTileN : kTileK;
            if constexpr (!is2BFloat) {
                if (bCols < bStride) {
                    AscendC::Duplicate(bIn, 0.0f, bRows * bStride);
                    AscendC::PipeBarrier<PIPE_V>();
                }
            }
            if (meta.transB == 0) {
                for (uint32_t k = 0; k < curK; ++k) {
                    const uint64_t bOff = bBase + static_cast<uint64_t>(k0 + k) * meta.N + n0;
                    CopyInRow(bIn[k * kTileN], bGm_, bOff, curN);
                }
            } else {
                for (uint32_t n = 0; n < curN; ++n) {
                    const uint64_t bOff = bBase + static_cast<uint64_t>(n0 + n) * meta.K + k0;
                    CopyInRow(bIn[n * kTileK], bGm_, bOff, curK);
                }
            }
            qB_.EnQue(bIn);

            aIn = qA_.DeQue<T>();
            bIn = qB_.DeQue<T>();

            // Convert A & B tiles to FP32 in UB (for 2B floats) or use directly (for FP32).
            // Partial tiles zero-initialize padded lanes so initcheck & Exp/Div never see garbage.
            AscendC::LocalTensor<float> aF32;
            AscendC::LocalTensor<float> bSrcF32;
            if constexpr (is2BFloat) {
                aF32 = aF32Buf_.Get<float>();
                bSrcF32 = bF32Buf_.Get<float>();
                if (curK == kTileK) {
                    SafeCast(aF32, aIn, AscendC::RoundMode::CAST_NONE, curM * kTileK);
                } else {
                    AscendC::Duplicate(aF32, 0.0f, curM * kTileK);
                    AscendC::PipeBarrier<PIPE_V>();
                    for (uint32_t m = 0; m < curM; ++m) {
                        SafeCast(aF32[m * kTileK], aIn[m * kTileK], AscendC::RoundMode::CAST_NONE, curK);
                    }
                }
                if (bCols == bStride) {
                    SafeCast(bSrcF32, bIn, AscendC::RoundMode::CAST_NONE, bRows * bStride);
                } else {
                    AscendC::Duplicate(bSrcF32, 0.0f, bRows * bStride);
                    AscendC::PipeBarrier<PIPE_V>();
                    for (uint32_t r = 0; r < bRows; ++r) {
                        SafeCast(bSrcF32[r * bStride], bIn[r * bStride], AscendC::RoundMode::CAST_NONE, bCols);
                    }
                }
                AscendC::PipeBarrier<PIPE_V>();
            } else {
                aF32 = aIn;
                bSrcF32 = bIn;
            }

            // Prepare B in [curK, kTileN] layout (zero-padded in [curN..kTileN) is harmless; we only write curN).
            AscendC::LocalTensor<float> bReady;
            SyncVToS(pipe);
            if (meta.transB == 0) {
                bReady = bSrcF32;
            } else {
                bReady = bTransBuf_.Get<float>();
                for (uint32_t k = 0; k < curK; ++k) {
                    for (uint32_t n = 0; n < curN; ++n) {
                        bReady.SetValue(k * kTileN + n, bSrcF32.GetValue(n * kTileK + k));
                    }
                    for (uint32_t n = curN; n < kTileN; ++n) {
                        bReady.SetValue(k * kTileN + n, 0.0f);
                    }
                }
                SyncSToV(pipe);
            }

            // 3. Outer-product vector accumulation: acc[m, 0..63] += a[m, k] * b[k, 0..63]
            for (uint32_t m = 0; m < curM; ++m) {
                auto accRow = acc[m * kTileN];
                for (uint32_t k = 0; k < curK; ++k) {
                    const float aVal = aF32.GetValue(m * kTileK + k);
                    if (aVal != 0.0f) {
                        AscendC::Axpy(accRow, bReady[k * kTileN], aVal, static_cast<int32_t>(kTileN));
                    }
                }
            }
            AscendC::PipeBarrier<PIPE_V>();
            SyncSToV(pipe);

            qA_.FreeTensor(aIn);
            qB_.FreeTensor(bIn);
        }

        // 4. Fused Epilogue in UB: alpha * acc + beta * C -> Activation
        if (meta.alpha != 1.0f) {
            AscendC::Muls(acc, acc, meta.alpha, static_cast<int32_t>(accCount));
            AscendC::PipeBarrier<PIPE_V>();
        }

        if (meta.biasMode != kBiasNone && meta.beta != 0.0f) {
            auto cIn = qC_.AllocTensor<T>();
            const uint32_t cRows = (meta.biasMode == kBiasRow) ? 1U : curM;
            if constexpr (!is2BFloat) {
                if (curN < kTileN) {
                    AscendC::Duplicate(cIn, 0.0f, cRows * kTileN);
                    AscendC::PipeBarrier<PIPE_V>();
                }
            }
            if (meta.biasMode == kBiasRow) {
                CopyInRow(cIn[0], cGm_, cBase + n0, curN);
            } else {
                for (uint32_t m = 0; m < curM; ++m) {
                    const uint64_t cOff = cBase + static_cast<uint64_t>(m0 + m) * meta.N + n0;
                    CopyInRow(cIn[m * kTileN], cGm_, cOff, curN);
                }
            }
            qC_.EnQue(cIn);
            cIn = qC_.DeQue<T>();

            auto cF32 = tmpBuf_.Get<float>();
            if constexpr (is2BFloat) {
                if (curN == kTileN) {
                    SafeCast(cF32, cIn, AscendC::RoundMode::CAST_NONE, cRows * kTileN);
                } else {
                    AscendC::Duplicate(cF32, 0.0f, cRows * kTileN);
                    AscendC::PipeBarrier<PIPE_V>();
                    for (uint32_t r = 0; r < cRows; ++r) {
                        SafeCast(cF32[r * kTileN], cIn[r * kTileN], AscendC::RoundMode::CAST_NONE, curN);
                    }
                }
                AscendC::PipeBarrier<PIPE_V>();
            } else {
                AscendC::DataCopy(cF32, cIn, cRows * kTileN);
                AscendC::PipeBarrier<PIPE_V>();
            }

            if (meta.biasMode == kBiasRow) {
                for (uint32_t m = 0; m < curM; ++m) {
                    if (meta.beta == 1.0f) {
                        AscendC::Add(acc[m * kTileN], acc[m * kTileN], cF32, static_cast<int32_t>(kTileN));
                    } else {
                        AscendC::Axpy(acc[m * kTileN], cF32, meta.beta, static_cast<int32_t>(kTileN));
                    }
                }
            } else {
                if (meta.beta == 1.0f) {
                    AscendC::Add(acc, acc, cF32, static_cast<int32_t>(accCount));
                } else {
                    AscendC::Axpy(acc, cF32, meta.beta, static_cast<int32_t>(accCount));
                }
            }
            AscendC::PipeBarrier<PIPE_V>();
            qC_.FreeTensor(cIn);
        }

        ApplyActivation(acc, accCount, meta.actMode);

        // 5. Cast back (if 2B float) and write curM x curN output tile to GM
        auto yOut = qY_.AllocTensor<T>();
        if constexpr (is2BFloat) {
            SafeCast(yOut, acc, AscendC::RoundMode::CAST_RINT, accCount);
        } else {
            AscendC::DataCopy(yOut, acc, accCount);
        }
        AscendC::PipeBarrier<PIPE_V>();
        qY_.EnQue(yOut);

        yOut = qY_.DeQue<T>();
        for (uint32_t m = 0; m < curM; ++m) {
            const uint64_t yOff = yBase + static_cast<uint64_t>(m0 + m) * meta.N + n0;
            CopyOutRow(yGm_, yOff, yOut[m * kTileN], curN);
        }
        qY_.FreeTensor(yOut);
    }

    __aicore__ inline void ApplyActivation(const AscendC::LocalTensor<float>& x, uint32_t count, int32_t actMode)
    {
        if (actMode == kActNone) {
            return;
        }
        if (actMode == kActRelu) {
            AscendC::Maxs(x, x, 0.0f, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            return;
        }
        auto t = tmpBuf_.Get<float>();
        if (actMode == kActSilu) {
            // SiLU(x) = x / (1 + exp(-x)), clamped to avoid exp overflow on large negative x.
            AscendC::Muls(t, x, -1.0f, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mins(t, t, 80.0f, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Exp(t, t, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(t, t, 1.0f, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(x, x, t, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            return;
        }
        if (actMode == kActGelu) {
            // Exact algebraic form of tanh-GELU:
            // 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
            // == x / (1 + exp(-2*sqrt(2/pi) * (x + 0.044715 * x^3)))
            constexpr float kNegTwoSqrt2OverPi = -1.5957691216057308f;
            AscendC::Mul(t, x, x, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(t, t, x, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(t, t, 0.044715f, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(t, t, x, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(t, t, kNegTwoSqrt2OverPi, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mins(t, t, 80.0f, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Exp(t, t, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Adds(t, t, 1.0f, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(x, x, t, static_cast<int32_t>(count));
            AscendC::PipeBarrier<PIPE_V>();
        }
    }

    AscendC::GlobalTensor<T> aGm_, bGm_, cGm_, yGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qA_, qB_, qC_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> accBuf_, tmpBuf_, aF32Buf_, bF32Buf_, bTransBuf_;
};

} // namespace NdBmmOp

__global__ __vector__ void nd_bmm_fused_fp32(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR y, NdBmmOp::NdBmmMeta meta)
{
    NdBmmOp::BatchedGemmFusedKernel<float, false> op;
    op.Run(reinterpret_cast<__gm__ float*>(a),
           reinterpret_cast<__gm__ float*>(b),
           reinterpret_cast<__gm__ float*>(c),
           reinterpret_cast<__gm__ float*>(y),
           meta);
}

__global__ __vector__ void nd_bmm_fused_fp16(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR y, NdBmmOp::NdBmmMeta meta)
{
    NdBmmOp::BatchedGemmFusedKernel<half, true> op;
    op.Run(reinterpret_cast<__gm__ half*>(a),
           reinterpret_cast<__gm__ half*>(b),
           reinterpret_cast<__gm__ half*>(c),
           reinterpret_cast<__gm__ half*>(y),
           meta);
}

__global__ __vector__ void nd_bmm_fused_bf16(GM_ADDR a, GM_ADDR b, GM_ADDR c, GM_ADDR y, NdBmmOp::NdBmmMeta meta)
{
    NdBmmOp::BatchedGemmFusedKernel<bfloat16_t, true> op;
    op.Run(reinterpret_cast<__gm__ bfloat16_t*>(a),
           reinterpret_cast<__gm__ bfloat16_t*>(b),
           reinterpret_cast<__gm__ bfloat16_t*>(c),
           reinterpret_cast<__gm__ bfloat16_t*>(y),
           meta);
}

struct NdBmmTensorDesc {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};

struct NdBmmConfig {
    bool transB = false;
    int32_t actMode = NdBmmOp::kActNone;
    float alpha = 1.0f;
    float beta = 1.0f;
};

// Host Dispatcher: validates N-D broadcast compatibility (2D..8D), computes batch strides, and launches AI Cores.
inline bool run_nd_bmm_fused(GM_ADDR a, const NdBmmTensorDesc& descA,
                             GM_ADDR b, const NdBmmTensorDesc& descB,
                             GM_ADDR c, const NdBmmTensorDesc* descC,
                             GM_ADDR y, const NdBmmTensorDesc& descY,
                             const NdBmmConfig& cfg,
                             int64_t availableCores,
                             aclrtStream stream)
{
    if (descA.numDims < 2 || descB.numDims < 2 || descY.numDims < 2 ||
        descA.numDims > NdBmmOp::kMaxTensorDims || descB.numDims > NdBmmOp::kMaxTensorDims ||
        descY.numDims > NdBmmOp::kMaxTensorDims) {
        return false;
    }
    const int32_t dtype = descY.dtype;
    if (descA.dtype != dtype || descB.dtype != dtype) {
        return false;
    }
    if (dtype != NdBmmOp::kDtypeFloat32 && dtype != NdBmmOp::kDtypeFloat16 && dtype != NdBmmOp::kDtypeBfloat16) {
        return false;
    }

    const int64_t M = descA.shape[descA.numDims - 2];
    const int64_t K = descA.shape[descA.numDims - 1];
    const int64_t bK = cfg.transB ? descB.shape[descB.numDims - 1] : descB.shape[descB.numDims - 2];
    const int64_t N = cfg.transB ? descB.shape[descB.numDims - 2] : descB.shape[descB.numDims - 1];
    if (M <= 0 || N <= 0 || K <= 0 || bK != K) {
        return false;
    }
    if (descY.shape[descY.numDims - 2] != M || descY.shape[descY.numDims - 1] != N) {
        return false;
    }

    const int64_t aBatchRank = descA.numDims - 2;
    const int64_t bBatchRank = descB.numDims - 2;
    const int64_t yBatchRank = descY.numDims - 2;
    int64_t cBatchRank = 0;
    int32_t biasMode = NdBmmOp::kBiasNone;

    if (descC != nullptr && c != nullptr) {
        if (descC->dtype != dtype || descC->numDims < 1 || descC->numDims > NdBmmOp::kMaxTensorDims) {
            return false;
        }
        if (descC->shape[descC->numDims - 1] != N) {
            return false;
        }
        if (descC->numDims == 1) {
            biasMode = NdBmmOp::kBiasRow;
            cBatchRank = 0;
        } else {
            const int64_t cM = descC->shape[descC->numDims - 2];
            if (cM == 1) {
                biasMode = NdBmmOp::kBiasRow;
            } else if (cM == M) {
                biasMode = NdBmmOp::kBiasMatrix;
            } else {
                return false;
            }
            cBatchRank = descC->numDims - 2;
        }
    }

    const int64_t maxBatchRank = std::max(yBatchRank, std::max(aBatchRank, std::max(bBatchRank, cBatchRank)));
    if (maxBatchRank > NdBmmOp::kMaxBatchDims || yBatchRank != maxBatchRank) {
        return false;
    }

    NdBmmOp::NdBmmMeta meta{};
    meta.M = static_cast<uint32_t>(M);
    meta.N = static_cast<uint32_t>(N);
    meta.K = static_cast<uint32_t>(K);
    meta.tilesM = (meta.M + NdBmmOp::kTileM - 1) / NdBmmOp::kTileM;
    meta.tilesN = (meta.N + NdBmmOp::kTileN - 1) / NdBmmOp::kTileN;
    meta.batchDims = static_cast<int32_t>(maxBatchRank);
    meta.transB = cfg.transB ? 1 : 0;
    meta.biasMode = biasMode;
    meta.actMode = cfg.actMode;
    meta.alpha = cfg.alpha;
    meta.beta = cfg.beta;

    uint64_t aStrideAcc = static_cast<uint64_t>(M) * static_cast<uint64_t>(K);
    uint64_t bStrideAcc = static_cast<uint64_t>(K) * static_cast<uint64_t>(N);
    uint64_t cStrideAcc = (biasMode == NdBmmOp::kBiasRow)
        ? static_cast<uint64_t>(N)
        : (biasMode == NdBmmOp::kBiasMatrix ? static_cast<uint64_t>(M) * static_cast<uint64_t>(N) : 0ULL);

    uint64_t totalBatches = 1;
    for (int64_t d = maxBatchRank - 1; d >= 0; --d) {
        const int64_t ia = d - (maxBatchRank - aBatchRank);
        const int64_t ib = d - (maxBatchRank - bBatchRank);
        const int64_t ic = d - (maxBatchRank - cBatchRank);
        const uint64_t da = (ia >= 0) ? static_cast<uint64_t>(descA.shape[ia]) : 1ULL;
        const uint64_t db = (ib >= 0) ? static_cast<uint64_t>(descB.shape[ib]) : 1ULL;
        const uint64_t dc = (biasMode != NdBmmOp::kBiasNone && ic >= 0)
            ? static_cast<uint64_t>(descC->shape[ic]) : 1ULL;
        const uint64_t dy = static_cast<uint64_t>(descY.shape[d]);
        if (da == 0 || db == 0 || dc == 0 || dy == 0) {
            return false;
        }
        if ((da != 1 && da != dy) || (db != 1 && db != dy) || (dc != 1 && dc != dy)) {
            return false;
        }
        meta.batchShape[d] = static_cast<uint32_t>(dy);
        meta.aBatchStrides[d] = (da == 1) ? 0ULL : aStrideAcc;
        meta.bBatchStrides[d] = (db == 1) ? 0ULL : bStrideAcc;
        meta.cBatchStrides[d] = (biasMode == NdBmmOp::kBiasNone || dc == 1) ? 0ULL : cStrideAcc;
        aStrideAcc *= da;
        bStrideAcc *= db;
        cStrideAcc *= dc;
        totalBatches *= dy;
    }

    meta.totalBatches = totalBatches;
    meta.totalTiles = totalBatches * static_cast<uint64_t>(meta.tilesM) * meta.tilesN;
    meta.aTotalElems = aStrideAcc;
    meta.bTotalElems = bStrideAcc;
    meta.cTotalElems = cStrideAcc;
    meta.yTotalElems = totalBatches * static_cast<uint64_t>(M) * static_cast<uint64_t>(N);

    const uint64_t maxCores = availableCores > 0 ? static_cast<uint64_t>(availableCores) : 1ULL;
    const uint32_t blockNum = static_cast<uint32_t>(std::min<uint64_t>(maxCores, std::max<uint64_t>(1ULL, meta.totalTiles)));

    if (dtype == NdBmmOp::kDtypeFloat32) {
        nd_bmm_fused_fp32<<<blockNum, nullptr, stream>>>(a, b, c, y, meta);
    } else if (dtype == NdBmmOp::kDtypeFloat16) {
        nd_bmm_fused_fp16<<<blockNum, nullptr, stream>>>(a, b, c, y, meta);
    } else {
        nd_bmm_fused_bf16<<<blockNum, nullptr, stream>>>(a, b, c, y, meta);
    }
    return true;
}
