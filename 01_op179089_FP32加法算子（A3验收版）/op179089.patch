+bool ParseShape(const char *text, std::vector<uint64_t> &shape, uint32_t &totalLength)
+{
+    shape.clear();
+    totalLength = 0;
+    if (text == nullptr || text[0] == '\0') {
+        return false;
+    }
+    uint64_t product = 1;
+    const char *cursor = text;
+    while (true) {
+        const char *sep = cursor;
+        while (*sep != '\0' && *sep != 'x' && *sep != 'X') {
+            ++sep;
+        }
+        if (sep == cursor || shape.size() >= kMaxDims) {
+            return false;
+        }
+        const std::string token(cursor, static_cast<size_t>(sep - cursor));
+        uint64_t extent = 0;
+        if (!ParseStrictUint64(token.c_str(), extent) || extent == 0 || extent > kMaxLength / product) {
+            return false;
+        }
+        shape.push_back(extent);
+        product *= extent;
+        if (*sep == '\0') {
+            break;
+        }
+        cursor = sep + 1;
+        if (*cursor == '\0') {
+            return false;
+        }
+    }
+    totalLength = static_cast<uint32_t>(product);
+    return true;
+}
 
+std::string FormatShape(const std::vector<uint64_t> &shape)
+{
+    std::string out;
+    for (size_t i = 0; i < shape.size(); ++i) {
+        if (i > 0) {
+            out.push_back('x');
+        }
+        out += std::to_string(shape[i]);
+    }
+    return out;
+}
+
+std::vector<uint64_t> BuildInputList(const std::vector<uint64_t> &shape, const void *deviceX, const void *deviceY)
+{
+    const uint64_t dim = static_cast<uint64_t>(shape.size());
+    const uint64_t wordsPerDesc = 1 + dim;
+    const uint64_t pointerOffset = (1 + 2 * wordsPerDesc) * sizeof(uint64_t);
+    std::vector<uint64_t> packed;
+    packed.reserve(static_cast<size_t>(1 + 2 * wordsPerDesc + 2));
+    packed.push_back(pointerOffset);
+    for (uint64_t index = 0; index < 2; ++index) {
+        // ListTensorDesc stores the rank in the low 32 bits and the pointer index in the high 32 bits.
+        packed.push_back((index << 32) | dim);
+        for (const uint64_t extent : shape) {
+            packed.push_back(extent);
+        }
+    }
+    packed.push_back(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(deviceX)));
+    packed.push_back(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(deviceY)));
+    return packed;
+}
