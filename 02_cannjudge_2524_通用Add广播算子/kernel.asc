__global__ __vector__ void add_same_fp32(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint64_t total)
{
    AddOp::SameShape4BKernel<float> op;
    op.Run(reinterpret_cast<__gm__ float*>(x1),
           reinterpret_cast<__gm__ float*>(x2),
           reinterpret_cast<__gm__ float*>(y),
           total);
}

__global__ __vector__ void add_same_i32(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint64_t total)
{
    AddOp::SameShape4BKernel<int32_t> op;
    op.Run(reinterpret_cast<__gm__ int32_t*>(x1),
           reinterpret_cast<__gm__ int32_t*>(x2),
           reinterpret_cast<__gm__ int32_t*>(y),
           total);
}

