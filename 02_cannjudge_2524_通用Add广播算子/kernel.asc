#include <algorithm>
#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

namespace AddOp {

constexpr int32_t kDtypeFloat32 = 0;
constexpr int32_t kDtypeFloat16 = 1;
constexpr int32_t kDtypeBfloat16 = 2;
constexpr int32_t kDtypeInt32 = 5;

constexpr uint64_t kMaxElements = 1ULL << 26;
// Once singleton axes are removed, each remaining extent is at least two.
constexpr int32_t kMaxDims = 26;
constexpr uint32_t kPackedColumnElements = 1024;
constexpr uint32_t kPackedColumnMaxWidth = 32;
constexpr uint32_t kPackedColumnMinRows = 128;
constexpr uint32_t kDmaAlignBytes = 32;
constexpr uint32_t kVectorRepeatBytes = 256;

// Tile sizes chosen so UB stays well below 192 KB with double buffering:
// - 4B types (fp32/int32): 3 queues * 2 buffers * 4096 * 4 B = 96 KB
// - 2B types (fp16/bf16):  3 queues * 2 buffers * 4096 * 2 B + 2 fp32 TBufs * 4096 * 4 B = 80 KB
constexpr uint32_t kTileElems4B = 4096;
constexpr uint32_t kTileElems2B = 4096;
constexpr uint8_t kDoubleBuffer = 2;

struct BroadcastMeta {
    uint64_t totalElements;
    uint64_t x1Elements;
    uint64_t x2Elements;
    uint64_t innerLen;
    uint64_t outerRows;
    int32_t outerDims;
    int32_t reserved;
    uint32_t outDims[kMaxDims];
    uint32_t x1Strides[kMaxDims];
    uint32_t x2Strides[kMaxDims];
};

// Split Level-2 Add on 256 B repeat boundary (64 elems for 4B) to avoid CANN 9.0
// Counter-Mode vadd memcheck UB OOB reports with zero extra DMA overhead.
template <typename T>
__aicore__ inline void SafeAdd4B(const AscendC::LocalTensor<T>& dst,
                                 const AscendC::LocalTensor<T>& src0,
                                 const AscendC::LocalTensor<T>& src1,
                                 uint32_t count)
{
    constexpr uint32_t kRepeatElems = kVectorRepeatBytes / sizeof(T);
    const uint32_t whole = count - (count % kRepeatElems);
    if (whole != 0) {
        AscendC::Add(dst, src0, src1, whole);
    }
    const uint32_t rem = count - whole;
    if (rem != 0) {
        AscendC::Add(dst[whole], src0[whole], src1[whole], rem);
    }
}

template <typename DstT, typename SrcT>
__aicore__ inline void SafeCast(const AscendC::LocalTensor<DstT>& dst,
                                const AscendC::LocalTensor<SrcT>& src,
                                AscendC::RoundMode mode,
                                uint32_t count)
{
    constexpr uint32_t kChunk = 64;
    const uint32_t whole = count - (count % kChunk);
    if (whole != 0) {
        AscendC::Cast(dst, src, mode, whole);
    }
    const uint32_t rem = count - whole;
    if (rem != 0) {
        AscendC::Cast(dst[whole], src[whole], mode, rem);
    }
}

template <typename T>
__aicore__ inline void CopyInTile(const AscendC::LocalTensor<T>& dst,
                                  const AscendC::GlobalTensor<T>& src,
                                  uint64_t gmOffset,
                                  uint32_t count)
{
    constexpr uint32_t kAlignElems = kDmaAlignBytes / sizeof(T);
    const bool aligned = ((gmOffset % kAlignElems) == 0) && ((count % kAlignElems) == 0);
    if (aligned) {
        AscendC::DataCopy(dst, src[gmOffset], count);
    } else {
        const AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        const AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, T{}};
        AscendC::DataCopyPad(dst, src[gmOffset], copy, pad);
    }
}

template <typename T>
__aicore__ inline void CopyOutTile(const AscendC::GlobalTensor<T>& dst,
                                   uint64_t gmOffset,
                                   const AscendC::LocalTensor<T>& src,
                                   uint32_t count)
{
    constexpr uint32_t kAlignElems = kDmaAlignBytes / sizeof(T);
    const bool aligned = ((gmOffset % kAlignElems) == 0) && ((count % kAlignElems) == 0);
    if (aligned) {
        AscendC::DataCopy(dst[gmOffset], src, count);
    } else {
        const AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(dst[gmOffset], src, copy);
    }
}

template <typename T>
__aicore__ inline T ReadScalarRaw(__gm__ T* ptr, uint64_t idx)
{
    AscendC::GlobalTensor<T> g;
    g.SetGlobalBuffer(ptr + idx, 1);
    return g.GetValue(0);
}

// Convert a single 2B float (half or bfloat16_t) in GM to FP32 via vector Cast in UB,
// avoiding scalar conversion portability issues and preserving IEEE NaN/Inf.
template <typename T>
__aicore__ inline float ReadScalar2BAsFloat(__gm__ T* ptr,
                                            uint64_t idx,
                                            AscendC::TQue<AscendC::TPosition::VECIN, 1>& qScalar,
                                            AscendC::TBuf<AscendC::TPosition::VECCALC>& f32Scratch)
{
    AscendC::GlobalTensor<T> g;
    g.SetGlobalBuffer(ptr + idx, 1);
    auto in = qScalar.AllocTensor<T>();
    const AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
    const AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, T{}};
    AscendC::DataCopyPad(in, g[0], copy, pad);
    qScalar.EnQue(in);

    in = qScalar.DeQue<T>();
    auto f32 = f32Scratch.Get<float>();
    AscendC::Cast(f32, in, AscendC::RoundMode::CAST_NONE, 1);
    AscendC::PipeBarrier<PIPE_V>();
    const float val = f32.GetValue(0);
    qScalar.FreeTensor(in);
    return val;
}

// ---------------------------------------------------------------------------
// 1. Same-Shape Contiguous Kernels (High-bandwidth HBM-saturating fast path)
// ---------------------------------------------------------------------------
template <typename T>
class SameShape4BKernel {
public:
    __aicore__ inline void Run(__gm__ T* x1, __gm__ T* x2, __gm__ T* y, uint64_t total)
    {
        constexpr uint32_t kAlign = kDmaAlignBytes / sizeof(T);
        const uint64_t block = AscendC::GetBlockIdx();
        const uint64_t blocks = AscendC::GetBlockNum();
        const uint64_t groups = (total + kAlign - 1) / kAlign;
        const uint64_t gpb = groups / blocks;
        const uint64_t extra = groups % blocks;
        const uint64_t pre = block < extra ? block : extra;
        const uint64_t start = (block * gpb + pre) * kAlign;
        const uint64_t end = start + (gpb + (block < extra ? 1 : 0)) * kAlign;
        const uint64_t stop = end < total ? end : total;
        if (start >= stop) {
            return;
        }
        const uint64_t blockLen = stop - start;
        x1_.SetGlobalBuffer(x1 + start, blockLen);
        x2_.SetGlobalBuffer(x2 + start, blockLen);
        y_.SetGlobalBuffer(y + start, blockLen);

        AscendC::TPipe pipe;
        const uint8_t buffers = blockLen > kTileElems4B ? kDoubleBuffer : 1;
        pipe.InitBuffer(q1_, buffers, kTileElems4B * sizeof(T));
        pipe.InitBuffer(q2_, buffers, kTileElems4B * sizeof(T));
        pipe.InitBuffer(qy_, buffers, kTileElems4B * sizeof(T));

        uint64_t offset = 0;
        for (; offset + kTileElems4B <= blockLen; offset += kTileElems4B) {
            Process<true>(offset, kTileElems4B);
        }
        const uint32_t tail = static_cast<uint32_t>(blockLen - offset);
        if (tail > 0) {
            if ((tail % kAlign) == 0) {
                Process<true>(offset, tail);
            } else {
                Process<false>(offset, tail);
            }
        }
    }

private:
    template <bool aligned>
    __aicore__ inline void Process(uint64_t offset, uint32_t count)
    {
        const AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};

        auto a = q1_.AllocTensor<T>();
        auto b = q2_.AllocTensor<T>();
        if (aligned) {
            AscendC::DataCopy(a, x1_[offset], count);
            AscendC::DataCopy(b, x2_[offset], count);
        } else {
            const AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, T{}};
            AscendC::DataCopyPad(a, x1_[offset], copy, pad);
            AscendC::DataCopyPad(b, x2_[offset], copy, pad);
        }
        q1_.EnQue(a);
        q2_.EnQue(b);

        a = q1_.DeQue<T>();
        b = q2_.DeQue<T>();
        auto c = qy_.AllocTensor<T>();
        SafeAdd4B(c, a, b, count);
        qy_.EnQue(c);
        q1_.FreeTensor(a);
        q2_.FreeTensor(b);

        c = qy_.DeQue<T>();
        if (aligned) {
            AscendC::DataCopy(y_[offset], c, count);
        } else {
            AscendC::DataCopyPad(y_[offset], c, copy);
        }
        qy_.FreeTensor(c);
    }

    AscendC::GlobalTensor<T> x1_, x2_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> q1_, q2_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qy_;
};

// Same-shape 2B float kernel (half / bfloat16_t): internal FP32 compute + CAST_RINT
template <typename T>
class SameShape2BFp32Kernel {
public:
    __aicore__ inline void Run(__gm__ T* x1, __gm__ T* x2, __gm__ T* y, uint64_t total)
    {
        constexpr uint32_t kAlign = kDmaAlignBytes / sizeof(T);
        const uint64_t block = AscendC::GetBlockIdx();
        const uint64_t blocks = AscendC::GetBlockNum();
        const uint64_t groups = (total + kAlign - 1) / kAlign;
        const uint64_t gpb = groups / blocks;
        const uint64_t extra = groups % blocks;
        const uint64_t pre = block < extra ? block : extra;
        const uint64_t start = (block * gpb + pre) * kAlign;
        const uint64_t end = start + (gpb + (block < extra ? 1 : 0)) * kAlign;
        const uint64_t stop = end < total ? end : total;
        if (start >= stop) {
            return;
        }
        const uint64_t blockLen = stop - start;
        x1_.SetGlobalBuffer(x1 + start, blockLen);
        x2_.SetGlobalBuffer(x2 + start, blockLen);
        y_.SetGlobalBuffer(y + start, blockLen);

        AscendC::TPipe pipe;
        const uint8_t buffers = blockLen > kTileElems2B ? kDoubleBuffer : 1;
        pipe.InitBuffer(q1_, buffers, kTileElems2B * sizeof(T));
        pipe.InitBuffer(q2_, buffers, kTileElems2B * sizeof(T));
        pipe.InitBuffer(qy_, buffers, kTileElems2B * sizeof(T));
        pipe.InitBuffer(tmp1_, kTileElems2B * sizeof(float));
        pipe.InitBuffer(tmp2_, kTileElems2B * sizeof(float));

        uint64_t offset = 0;
        for (; offset + kTileElems2B <= blockLen; offset += kTileElems2B) {
            Process<true>(offset, kTileElems2B);
        }
        const uint32_t tail = static_cast<uint32_t>(blockLen - offset);
        if (tail > 0) {
            if ((tail % kAlign) == 0) {
                Process<true>(offset, tail);
            } else {
                Process<false>(offset, tail);
            }
        }
    }

private:
    template <bool aligned>
    __aicore__ inline void Process(uint64_t offset, uint32_t count)
    {
        const AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};

        auto a = q1_.AllocTensor<T>();
        auto b = q2_.AllocTensor<T>();
        if (aligned) {
            AscendC::DataCopy(a, x1_[offset], count);
            AscendC::DataCopy(b, x2_[offset], count);
        } else {
            const AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, T{}};
            AscendC::DataCopyPad(a, x1_[offset], copy, pad);
            AscendC::DataCopyPad(b, x2_[offset], copy, pad);
        }
        q1_.EnQue(a);
        q2_.EnQue(b);

        a = q1_.DeQue<T>();
        b = q2_.DeQue<T>();
        auto c = qy_.AllocTensor<T>();
        auto f1 = tmp1_.Get<float>();
        auto f2 = tmp2_.Get<float>();
        SafeCast(f1, a, AscendC::RoundMode::CAST_NONE, count);
        SafeCast(f2, b, AscendC::RoundMode::CAST_NONE, count);
        SafeAdd4B(f1, f1, f2, count);
        SafeCast(c, f1, AscendC::RoundMode::CAST_RINT, count);
        qy_.EnQue(c);
        q1_.FreeTensor(a);
        q2_.FreeTensor(b);

        c = qy_.DeQue<T>();
        if (aligned) {
            AscendC::DataCopy(y_[offset], c, count);
        } else {
            AscendC::DataCopyPad(y_[offset], c, copy);
        }
        qy_.FreeTensor(c);
    }

    AscendC::GlobalTensor<T> x1_, x2_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> q1_, q2_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qy_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp1_, tmp2_;
};

// ---------------------------------------------------------------------------
// 2. Scalar Broadcast Kernels (1 read + 1 write per tile, full HBM bandwidth)
// ---------------------------------------------------------------------------
template <typename T>
class ScalarBcast4BKernel {
public:
    __aicore__ inline void Run(__gm__ T* vec, __gm__ T* scalarPtr, __gm__ T* y, uint64_t total)
    {
        constexpr uint32_t kAlign = kDmaAlignBytes / sizeof(T);
        const uint64_t block = AscendC::GetBlockIdx();
        const uint64_t blocks = AscendC::GetBlockNum();
        const uint64_t groups = (total + kAlign - 1) / kAlign;
        const uint64_t gpb = groups / blocks;
        const uint64_t extra = groups % blocks;
        const uint64_t pre = block < extra ? block : extra;
        const uint64_t start = (block * gpb + pre) * kAlign;
        const uint64_t end = start + (gpb + (block < extra ? 1 : 0)) * kAlign;
        const uint64_t stop = end < total ? end : total;
        if (start >= stop) {
            return;
        }
        const uint64_t blockLen = stop - start;
        x_.SetGlobalBuffer(vec + start, blockLen);
        y_.SetGlobalBuffer(y + start, blockLen);

        AscendC::TPipe pipe;
        const uint8_t buffers = blockLen > kTileElems4B ? kDoubleBuffer : 1;
        pipe.InitBuffer(qx_, buffers, kTileElems4B * sizeof(T));
        pipe.InitBuffer(qy_, buffers, kTileElems4B * sizeof(T));
        pipe.InitBuffer(sBuf_, kTileElems4B * sizeof(T));

        const T sVal = ReadScalarRaw(scalarPtr, 0);
        auto sTensor = sBuf_.Get<T>();
        AscendC::Duplicate(sTensor, sVal, kTileElems4B);

        uint64_t offset = 0;
        for (; offset + kTileElems4B <= blockLen; offset += kTileElems4B) {
            Process(offset, kTileElems4B, sTensor);
        }
        const uint32_t tail = static_cast<uint32_t>(blockLen - offset);
        if (tail > 0) {
            Process(offset, tail, sTensor);
        }
    }

private:
    __aicore__ inline void Process(uint64_t offset, uint32_t count, const AscendC::LocalTensor<T>& sTensor)
    {
        auto a = qx_.AllocTensor<T>();
        CopyInTile(a, x_, offset, count);
        qx_.EnQue(a);

        a = qx_.DeQue<T>();
        auto c = qy_.AllocTensor<T>();
        SafeAdd4B(c, a, sTensor, count);
        qy_.EnQue(c);
        qx_.FreeTensor(a);

        c = qy_.DeQue<T>();
        CopyOutTile(y_, offset, c, count);
        qy_.FreeTensor(c);
    }

    AscendC::GlobalTensor<T> x_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qx_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qy_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sBuf_;
};

template <typename T>
class ScalarBcast2BFp32Kernel {
public:
    __aicore__ inline void Run(__gm__ T* vec, __gm__ T* scalarPtr, __gm__ T* y, uint64_t total)
    {
        constexpr uint32_t kAlign = kDmaAlignBytes / sizeof(T);
        const uint64_t block = AscendC::GetBlockIdx();
        const uint64_t blocks = AscendC::GetBlockNum();
        const uint64_t groups = (total + kAlign - 1) / kAlign;
        const uint64_t gpb = groups / blocks;
        const uint64_t extra = groups % blocks;
        const uint64_t pre = block < extra ? block : extra;
        const uint64_t start = (block * gpb + pre) * kAlign;
        const uint64_t end = start + (gpb + (block < extra ? 1 : 0)) * kAlign;
        const uint64_t stop = end < total ? end : total;
        if (start >= stop) {
            return;
        }
        const uint64_t blockLen = stop - start;
        x_.SetGlobalBuffer(vec + start, blockLen);
        y_.SetGlobalBuffer(y + start, blockLen);

        AscendC::TPipe pipe;
        const uint8_t buffers = blockLen > kTileElems2B ? kDoubleBuffer : 1;
        pipe.InitBuffer(qx_, buffers, kTileElems2B * sizeof(T));
        pipe.InitBuffer(qy_, buffers, kTileElems2B * sizeof(T));
        pipe.InitBuffer(qScalar_, 1, kDmaAlignBytes);
        pipe.InitBuffer(tmp1_, kTileElems2B * sizeof(float));
        pipe.InitBuffer(sBuf_, kTileElems2B * sizeof(float));

        const float sVal = ReadScalar2BAsFloat(scalarPtr, 0, qScalar_, tmp1_);
        auto sTensor = sBuf_.Get<float>();
        AscendC::Duplicate(sTensor, sVal, kTileElems2B);

        uint64_t offset = 0;
        for (; offset + kTileElems2B <= blockLen; offset += kTileElems2B) {
            Process(offset, kTileElems2B, sTensor);
        }
        const uint32_t tail = static_cast<uint32_t>(blockLen - offset);
        if (tail > 0) {
            Process(offset, tail, sTensor);
        }
    }

private:
    __aicore__ inline void Process(uint64_t offset, uint32_t count, const AscendC::LocalTensor<float>& sTensor)
    {
        auto a = qx_.AllocTensor<T>();
        CopyInTile(a, x_, offset, count);
        qx_.EnQue(a);

        a = qx_.DeQue<T>();
        auto c = qy_.AllocTensor<T>();
        auto f1 = tmp1_.Get<float>();
        SafeCast(f1, a, AscendC::RoundMode::CAST_NONE, count);
        SafeAdd4B(f1, f1, sTensor, count);
        SafeCast(c, f1, AscendC::RoundMode::CAST_RINT, count);
        qy_.EnQue(c);
        qx_.FreeTensor(a);

        c = qy_.DeQue<T>();
        CopyOutTile(y_, offset, c, count);
        qy_.FreeTensor(c);
    }

    AscendC::GlobalTensor<T> x_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qx_, qScalar_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qy_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp1_, sBuf_;
};

// ---------------------------------------------------------------------------
// 2b. UB-Cached Row Broadcast Kernels: (M, K) + (1, K) with K <= kTile & 32B-aligned
//     Loads and (for 2B float) casts the [K] bias vector ONCE into UB -> 1 read + 1 write per row!
// ---------------------------------------------------------------------------
template <typename T>
class RowBcast4BKernel {
public:
    __aicore__ inline void Run(__gm__ T* mat, __gm__ T* rowPtr, __gm__ T* y, uint64_t total, uint32_t K)
    {
        constexpr uint32_t kAlign = kDmaAlignBytes / sizeof(T);
        const uint64_t block = AscendC::GetBlockIdx();
        const uint64_t blocks = AscendC::GetBlockNum();
        const uint64_t groups = (total + kAlign - 1) / kAlign;
        const uint64_t gpb = groups / blocks;
        const uint64_t extra = groups % blocks;
        const uint64_t pre = block < extra ? block : extra;
        const uint64_t start = (block * gpb + pre) * kAlign;
        const uint64_t end = start + (gpb + (block < extra ? 1 : 0)) * kAlign;
        const uint64_t stop = end < total ? end : total;
        if (start >= stop) {
            return;
        }
        mat_.SetGlobalBuffer(mat, total);
        y_.SetGlobalBuffer(y, total);
        AscendC::GlobalTensor<T> rowGm;
        rowGm.SetGlobalBuffer(rowPtr, K);

        AscendC::TPipe pipe;
        pipe.InitBuffer(qx_, kDoubleBuffer, kTileElems4B * sizeof(T));
        pipe.InitBuffer(qy_, kDoubleBuffer, kTileElems4B * sizeof(T));
        pipe.InitBuffer(qRow_, 1, kTileElems4B * sizeof(T));

        auto rIn = qRow_.AllocTensor<T>();
        AscendC::DataCopy(rIn, rowGm[0], K);
        qRow_.EnQue(rIn);
        rIn = qRow_.DeQue<T>();

        uint64_t pos = start;
        uint32_t col = static_cast<uint32_t>(pos % K);
        while (pos < stop) {
            const uint32_t rowRem = K - col;
            const uint64_t blkRem = stop - pos;
            const uint32_t cnt = static_cast<uint32_t>(rowRem < blkRem ? rowRem : blkRem);

            auto a = qx_.AllocTensor<T>();
            AscendC::DataCopy(a, mat_[pos], cnt);
            qx_.EnQue(a);

            a = qx_.DeQue<T>();
            auto c = qy_.AllocTensor<T>();
            SafeAdd4B(c, a, rIn[col], cnt);
            qy_.EnQue(c);
            qx_.FreeTensor(a);

            c = qy_.DeQue<T>();
            AscendC::DataCopy(y_[pos], c, cnt);
            qy_.FreeTensor(c);

            pos += cnt;
            col += cnt;
            if (col == K) {
                col = 0;
            }
        }
        qRow_.FreeTensor(rIn);
    }

private:
    AscendC::GlobalTensor<T> mat_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qx_, qRow_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qy_;
};

template <typename T>
class RowBcast2BFp32Kernel {
public:
    __aicore__ inline void Run(__gm__ T* mat, __gm__ T* rowPtr, __gm__ T* y, uint64_t total, uint32_t K)
    {
        constexpr uint32_t kAlign = kDmaAlignBytes / sizeof(T);
        const uint64_t block = AscendC::GetBlockIdx();
        const uint64_t blocks = AscendC::GetBlockNum();
        const uint64_t groups = (total + kAlign - 1) / kAlign;
        const uint64_t gpb = groups / blocks;
        const uint64_t extra = groups % blocks;
        const uint64_t pre = block < extra ? block : extra;
        const uint64_t start = (block * gpb + pre) * kAlign;
        const uint64_t end = start + (gpb + (block < extra ? 1 : 0)) * kAlign;
        const uint64_t stop = end < total ? end : total;
        if (start >= stop) {
            return;
        }
        mat_.SetGlobalBuffer(mat, total);
        y_.SetGlobalBuffer(y, total);
        AscendC::GlobalTensor<T> rowGm;
        rowGm.SetGlobalBuffer(rowPtr, K);

        AscendC::TPipe pipe;
        pipe.InitBuffer(qx_, kDoubleBuffer, kTileElems2B * sizeof(T));
        pipe.InitBuffer(qy_, kDoubleBuffer, kTileElems2B * sizeof(T));
        pipe.InitBuffer(qRow_, 1, kTileElems2B * sizeof(T));
        pipe.InitBuffer(tmp1_, kTileElems2B * sizeof(float));
        pipe.InitBuffer(rowF32_, kTileElems2B * sizeof(float));

        auto rIn = qRow_.AllocTensor<T>();
        AscendC::DataCopy(rIn, rowGm[0], K);
        qRow_.EnQue(rIn);
        rIn = qRow_.DeQue<T>();
        auto rF32 = rowF32_.Get<float>();
        SafeCast(rF32, rIn, AscendC::RoundMode::CAST_NONE, K);
        qRow_.FreeTensor(rIn);

        uint64_t pos = start;
        uint32_t col = static_cast<uint32_t>(pos % K);
        while (pos < stop) {
            const uint32_t rowRem = K - col;
            const uint64_t blkRem = stop - pos;
            const uint32_t cnt = static_cast<uint32_t>(rowRem < blkRem ? rowRem : blkRem);

            auto a = qx_.AllocTensor<T>();
            AscendC::DataCopy(a, mat_[pos], cnt);
            qx_.EnQue(a);

            a = qx_.DeQue<T>();
            auto c = qy_.AllocTensor<T>();
            auto f1 = tmp1_.Get<float>();
            SafeCast(f1, a, AscendC::RoundMode::CAST_NONE, cnt);
            SafeAdd4B(f1, f1, rF32[col], cnt);
            SafeCast(c, f1, AscendC::RoundMode::CAST_RINT, cnt);
            qy_.EnQue(c);
            qx_.FreeTensor(a);

            c = qy_.DeQue<T>();
            AscendC::DataCopy(y_[pos], c, cnt);
            qy_.FreeTensor(c);

            pos += cnt;
            col += cnt;
            if (col == K) {
                col = 0;
            }
        }
    }

private:
    AscendC::GlobalTensor<T> mat_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qx_, qRow_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qy_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp1_, rowF32_;
};

// ---------------------------------------------------------------------------
// 3. General ND Broadcast Helpers & Kernels
//    After dimension coalescing, every broadcast tensor has:
//    - Path 3a: innermost dim K contiguous in BOTH x1 and x2
//    - Path 3b: innermost dim K contiguous in vec, broadcast (stride 0) in bcast
// ---------------------------------------------------------------------------
__aicore__ inline void ComputeRowBases(uint64_t row,
                                       const BroadcastMeta& meta,
                                       uint64_t& x1Base,
                                       uint64_t& x2Base)
{
    uint64_t rem = row;
    uint64_t off1 = 0;
    uint64_t off2 = 0;
    for (int32_t d = meta.outerDims - 1; d >= 0; --d) {
        const uint64_t dim = meta.outDims[d];
        const uint64_t coord = rem % dim;
        rem /= dim;
        off1 += coord * meta.x1Strides[d];
        off2 += coord * meta.x2Strides[d];
    }
    x1Base = off1;
    x2Base = off2;
}

template <uint32_t kAlignElems>
__aicore__ inline void PartitionBroadcastRange(uint64_t totalElements,
                                               uint64_t& elemStart,
                                               uint64_t& elemStop)
{
    const uint64_t block = AscendC::GetBlockIdx();
    const uint64_t blocks = AscendC::GetBlockNum();
    const uint64_t groups = (totalElements + kAlignElems - 1) / kAlignElems;
    const uint64_t gpb = groups / blocks;
    const uint64_t extra = groups % blocks;
    const uint64_t pre = block < extra ? block : extra;
    elemStart = (block * gpb + pre) * kAlignElems;
    const uint64_t end = elemStart + (gpb + (block < extra ? 1 : 0)) * kAlignElems;
    elemStop = end < totalElements ? end : totalElements;
}

template <typename T, bool is2BFloat>
class BroadcastBothContigKernel {
public:
    __aicore__ inline void Run(__gm__ T* x1, __gm__ T* x2, __gm__ T* y, const BroadcastMeta& meta)
    {
        constexpr uint32_t kAlign = kDmaAlignBytes / sizeof(T);
        constexpr uint32_t kTile = is2BFloat ? kTileElems2B : kTileElems4B;
        uint64_t start = 0;
        uint64_t stop = 0;
        PartitionBroadcastRange<kAlign>(meta.totalElements, start, stop);
        if (start >= stop) {
            return;
        }

        x1_.SetGlobalBuffer(x1, meta.x1Elements);
        x2_.SetGlobalBuffer(x2, meta.x2Elements);
        y_.SetGlobalBuffer(y, meta.totalElements);

        AscendC::TPipe pipe;
        pipe.InitBuffer(q1_, kDoubleBuffer, kTile * sizeof(T));
        pipe.InitBuffer(q2_, kDoubleBuffer, kTile * sizeof(T));
        pipe.InitBuffer(qy_, kDoubleBuffer, kTile * sizeof(T));
        if (is2BFloat) {
            pipe.InitBuffer(tmp1_, kTile * sizeof(float));
            pipe.InitBuffer(tmp2_, kTile * sizeof(float));
        }

        const uint64_t K = meta.innerLen;
        uint64_t pos = start;
        uint64_t curRow = pos / K;
        uint64_t col = pos % K;
        uint64_t x1Base = 0;
        uint64_t x2Base = 0;
        ComputeRowBases(curRow, meta, x1Base, x2Base);

        while (pos < stop) {
            const uint64_t rowRem = K - col;
            const uint64_t blkRem = stop - pos;
            const uint64_t seg = rowRem < blkRem ? rowRem : blkRem;
            const uint32_t cnt = static_cast<uint32_t>(seg < kTile ? seg : kTile);

            ProcessSegment(x1Base + col, x2Base + col, pos, cnt);

            pos += cnt;
            col += cnt;
            if (col == K && pos < stop) {
                col = 0;
                ++curRow;
                ComputeRowBases(curRow, meta, x1Base, x2Base);
            }
        }
    }

    __aicore__ inline void RunPackedColumn(__gm__ T* x, __gm__ T* bias, __gm__ T* y,
                                           const BroadcastMeta& meta)
    {
        constexpr uint32_t kAlign = kDmaAlignBytes / sizeof(T);
        const uint32_t width = static_cast<uint32_t>(meta.innerLen);
        const uint32_t rowsPerTile = kPackedColumnElements / width / kAlign * kAlign;
        uint64_t rowStart = 0;
        uint64_t rowStop = 0;
        // Partition by aligned row groups so the matrix/output starts are aligned as well.
        PartitionBroadcastRange<kAlign>(meta.outerRows, rowStart, rowStop);
        if (rowStart >= rowStop) {
            return;
        }

        x1_.SetGlobalBuffer(x, meta.totalElements);
        x2_.SetGlobalBuffer(bias, meta.outerRows);
        y_.SetGlobalBuffer(y, meta.totalElements);

        AscendC::TPipe pipe;
        pipe.InitBuffer(q1_, kDoubleBuffer, kPackedColumnElements * sizeof(T));
        pipe.InitBuffer(q2_, kDoubleBuffer, rowsPerTile * sizeof(T));
        pipe.InitBuffer(qy_, kDoubleBuffer, kPackedColumnElements * sizeof(T));
        if (is2BFloat) {
            pipe.InitBuffer(tmp1_, kPackedColumnElements * sizeof(float));
            pipe.InitBuffer(tmp2_, kPackedColumnElements * sizeof(float));
        }
        AscendC::TBuf<AscendC::TPosition::VECCALC> offsetsBuf, expandedBuf;
        pipe.InitBuffer(offsetsBuf, kPackedColumnElements * sizeof(uint32_t));
        pipe.InitBuffer(expandedBuf, kPackedColumnElements * sizeof(T));

        // Reuse the same byte offsets for every tile, including the final partial tile.
        auto offsets = offsetsBuf.Get<uint32_t>();
        const uint32_t indexRows = static_cast<uint32_t>(
            rowStop - rowStart < rowsPerTile ? rowStop - rowStart : rowsPerTile);
        for (uint32_t row = 0; row < indexRows; ++row) {
            for (uint32_t col = 0; col < width; ++col) {
                offsets.SetValue(row * width + col, row * sizeof(T));
            }
        }
        auto event = pipe.FetchEventID(AscendC::HardEvent::S_V);
        AscendC::SetFlag<AscendC::HardEvent::S_V>(event);
        AscendC::WaitFlag<AscendC::HardEvent::S_V>(event);

        auto expanded = expandedBuf.Get<T>();
        for (uint64_t row = rowStart; row < rowStop; row += rowsPerTile) {
            const uint64_t remaining = rowStop - row;
            const uint32_t rows = static_cast<uint32_t>(remaining < rowsPerTile ? remaining : rowsPerTile);
            const uint32_t count = rows * width;
            const uint64_t matrixOffset = row * width;

            auto values = q1_.AllocTensor<T>();
            auto biasValues = q2_.AllocTensor<T>();
            CopyInTile(values, x1_, matrixOffset, count);
            CopyInTile(biasValues, x2_, row, rows);
            q1_.EnQue(values);
            q2_.EnQue(biasValues);

            values = q1_.DeQue<T>();
            biasValues = q2_.DeQue<T>();
            auto result = qy_.AllocTensor<T>();
            AscendC::Gather(expanded, biasValues, offsets, 0, count);
            ComputeAdd(result, values, expanded, count);
            qy_.EnQue(result);
            q1_.FreeTensor(values);
            q2_.FreeTensor(biasValues);

            result = qy_.DeQue<T>();
            CopyOutTile(y_, matrixOffset, result, count);
            qy_.FreeTensor(result);
        }
    }

private:
    __aicore__ inline void ProcessSegment(uint64_t off1, uint64_t off2, uint64_t offY, uint32_t count)
    {
        auto a = q1_.AllocTensor<T>();
        auto b = q2_.AllocTensor<T>();
        CopyInTile(a, x1_, off1, count);
        CopyInTile(b, x2_, off2, count);
        q1_.EnQue(a);
        q2_.EnQue(b);

        a = q1_.DeQue<T>();
        b = q2_.DeQue<T>();
        auto c = qy_.AllocTensor<T>();
        ComputeAdd(c, a, b, count);
        qy_.EnQue(c);
        q1_.FreeTensor(a);
        q2_.FreeTensor(b);

        c = qy_.DeQue<T>();
        CopyOutTile(y_, offY, c, count);
        qy_.FreeTensor(c);
    }

    __aicore__ inline void ComputeAdd(const AscendC::LocalTensor<float>& c,
                                      const AscendC::LocalTensor<float>& a,
                                      const AscendC::LocalTensor<float>& b,
                                      uint32_t count)
    {
        SafeAdd4B(c, a, b, count);
    }

    __aicore__ inline void ComputeAdd(const AscendC::LocalTensor<int32_t>& c,
                                      const AscendC::LocalTensor<int32_t>& a,
                                      const AscendC::LocalTensor<int32_t>& b,
                                      uint32_t count)
    {
        SafeAdd4B(c, a, b, count);
    }

    __aicore__ inline void ComputeAdd(const AscendC::LocalTensor<half>& c,
                                      const AscendC::LocalTensor<half>& a,
                                      const AscendC::LocalTensor<half>& b,
                                      uint32_t count)
    {
        auto f1 = tmp1_.Get<float>();
        auto f2 = tmp2_.Get<float>();
        SafeCast(f1, a, AscendC::RoundMode::CAST_NONE, count);
        SafeCast(f2, b, AscendC::RoundMode::CAST_NONE, count);
        SafeAdd4B(f1, f1, f2, count);
        SafeCast(c, f1, AscendC::RoundMode::CAST_RINT, count);
    }

    __aicore__ inline void ComputeAdd(const AscendC::LocalTensor<bfloat16_t>& c,
                                      const AscendC::LocalTensor<bfloat16_t>& a,
                                      const AscendC::LocalTensor<bfloat16_t>& b,
                                      uint32_t count)
    {
        auto f1 = tmp1_.Get<float>();
        auto f2 = tmp2_.Get<float>();
        SafeCast(f1, a, AscendC::RoundMode::CAST_NONE, count);
        SafeCast(f2, b, AscendC::RoundMode::CAST_NONE, count);
        SafeAdd4B(f1, f1, f2, count);
        SafeCast(c, f1, AscendC::RoundMode::CAST_RINT, count);
    }

    AscendC::GlobalTensor<T> x1_, x2_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> q1_, q2_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qy_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp1_, tmp2_;
};

template <typename T, bool is2BFloat>
class BroadcastInnerScalarKernel {
public:
    __aicore__ inline void Run(__gm__ T* vec, __gm__ T* bcast, __gm__ T* y, const BroadcastMeta& meta)
    {
        if (meta.outerDims == 1 && meta.x1Strides[0] == meta.innerLen &&
            meta.x2Strides[0] == 1 && meta.innerLen <= kPackedColumnMaxWidth &&
            meta.outerRows >= kPackedColumnMinRows) {
            BroadcastBothContigKernel<T, is2BFloat> packed;
            packed.RunPackedColumn(vec, bcast, y, meta);
            return;
        }

        constexpr uint32_t kAlign = kDmaAlignBytes / sizeof(T);
        constexpr uint32_t kTile = is2BFloat ? kTileElems2B : kTileElems4B;
        uint64_t start = 0;
        uint64_t stop = 0;
        PartitionBroadcastRange<kAlign>(meta.totalElements, start, stop);
        if (start >= stop) {
            return;
        }

        vec_.SetGlobalBuffer(vec, meta.x1Elements);
        y_.SetGlobalBuffer(y, meta.totalElements);

        AscendC::TPipe pipe;
        pipe.InitBuffer(qx_, kDoubleBuffer, kTile * sizeof(T));
        pipe.InitBuffer(qy_, kDoubleBuffer, kTile * sizeof(T));
        if (is2BFloat) {
            pipe.InitBuffer(qScalar_, 1, kDmaAlignBytes);
            pipe.InitBuffer(tmp1_, kTile * sizeof(float));
            pipe.InitBuffer(sBufF32_, kTile * sizeof(float));
        } else {
            pipe.InitBuffer(sBufRaw_, kTile * sizeof(T));
        }

        const uint64_t K = meta.innerLen;
        uint64_t pos = start;
        uint64_t curRow = pos / K;
        uint64_t col = pos % K;
        uint64_t vBase = 0;
        uint64_t sBase = 0;
        ComputeRowBases(curRow, meta, vBase, sBase);

        uint64_t cachedSBase = ~static_cast<uint64_t>(0);
        uint32_t filledElems = 0;

        while (pos < stop) {
            const uint64_t rowRem = K - col;
            const uint64_t blkRem = stop - pos;
            const uint64_t seg = rowRem < blkRem ? rowRem : blkRem;
            const uint32_t cnt = static_cast<uint32_t>(seg < kTile ? seg : kTile);

            if (sBase != cachedSBase || cnt > filledElems) {
                const uint32_t dupCnt = ((cnt + 63) / 64) * 64;
                const uint32_t safeDup = dupCnt < kTile ? dupCnt : kTile;
                FillScalar(bcast, sBase, safeDup);
                cachedSBase = sBase;
                filledElems = safeDup;
            }

            ProcessSegment(vBase + col, pos, cnt);

            pos += cnt;
            col += cnt;
            if (col == K && pos < stop) {
                col = 0;
                ++curRow;
                ComputeRowBases(curRow, meta, vBase, sBase);
            }
        }
    }

private:
    __aicore__ inline void FillScalar(__gm__ float* bcast, uint64_t idx, uint32_t count)
    {
        const float v = ReadScalarRaw(bcast, idx);
        auto s = sBufRaw_.Get<float>();
        AscendC::Duplicate(s, v, count);
    }

    __aicore__ inline void FillScalar(__gm__ int32_t* bcast, uint64_t idx, uint32_t count)
    {
        const int32_t v = ReadScalarRaw(bcast, idx);
        auto s = sBufRaw_.Get<int32_t>();
        AscendC::Duplicate(s, v, count);
    }

    __aicore__ inline void FillScalar(__gm__ half* bcast, uint64_t idx, uint32_t count)
    {
        const float v = ReadScalar2BAsFloat(bcast, idx, qScalar_, tmp1_);
        auto s = sBufF32_.Get<float>();
        AscendC::Duplicate(s, v, count);
    }

    __aicore__ inline void FillScalar(__gm__ bfloat16_t* bcast, uint64_t idx, uint32_t count)
    {
        const float v = ReadScalar2BAsFloat(bcast, idx, qScalar_, tmp1_);
        auto s = sBufF32_.Get<float>();
        AscendC::Duplicate(s, v, count);
    }

    __aicore__ inline void ProcessSegment(uint64_t offV, uint64_t offY, uint32_t count)
    {
        auto a = qx_.AllocTensor<T>();
        CopyInTile(a, vec_, offV, count);
        qx_.EnQue(a);

        a = qx_.DeQue<T>();
        auto c = qy_.AllocTensor<T>();
        ComputeAddScalar(c, a, count);
        qy_.EnQue(c);
        qx_.FreeTensor(a);

        c = qy_.DeQue<T>();
        CopyOutTile(y_, offY, c, count);
        qy_.FreeTensor(c);
    }

    __aicore__ inline void ComputeAddScalar(const AscendC::LocalTensor<float>& c,
                                            const AscendC::LocalTensor<float>& a,
                                            uint32_t count)
    {
        auto s = sBufRaw_.Get<float>();
        SafeAdd4B(c, a, s, count);
    }

    __aicore__ inline void ComputeAddScalar(const AscendC::LocalTensor<int32_t>& c,
                                            const AscendC::LocalTensor<int32_t>& a,
                                            uint32_t count)
    {
        auto s = sBufRaw_.Get<int32_t>();
        SafeAdd4B(c, a, s, count);
    }

    __aicore__ inline void ComputeAddScalar(const AscendC::LocalTensor<half>& c,
                                            const AscendC::LocalTensor<half>& a,
                                            uint32_t count)
    {
        auto f1 = tmp1_.Get<float>();
        auto s = sBufF32_.Get<float>();
        SafeCast(f1, a, AscendC::RoundMode::CAST_NONE, count);
        SafeAdd4B(f1, f1, s, count);
        SafeCast(c, f1, AscendC::RoundMode::CAST_RINT, count);
    }

    __aicore__ inline void ComputeAddScalar(const AscendC::LocalTensor<bfloat16_t>& c,
                                            const AscendC::LocalTensor<bfloat16_t>& a,
                                            uint32_t count)
    {
        auto f1 = tmp1_.Get<float>();
        auto s = sBufF32_.Get<float>();
        SafeCast(f1, a, AscendC::RoundMode::CAST_NONE, count);
        SafeAdd4B(f1, f1, s, count);
        SafeCast(c, f1, AscendC::RoundMode::CAST_RINT, count);
    }

    AscendC::GlobalTensor<T> vec_, y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> qx_, qScalar_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> qy_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp1_, sBufF32_, sBufRaw_;
};

